{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "news",
    "pluralName": "news",
    "displayName": "News",
    "description": "Company news and industry articles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "date"
    },
    "category": {
      "type": "enumeration",
      "enum": ["industry-news", "company-news", "product-launch", "trade-show", "market-trends"]
    },
    "tags": {
      "type": "json"
    }
  }
}
