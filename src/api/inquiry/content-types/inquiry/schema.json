{
  "kind": "collectionType",
  "collectionName": "inquiries",
  "info": {
    "singularName": "inquiry",
    "pluralName": "inquiries",
    "displayName": "Inquiry",
    "description": "Customer B2B inquiries from website"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "required": true
    },
    "productCategory": {
      "type": "enumeration",
      "enum": ["electric-motorcycle", "electric-bicycle", "motor", "shock-absorber", "multiple", "other"]
    },
    "message": {
      "type": "text",
      "required": true
    },
    "source": {
      "type": "string",
      "default": "website"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "qualified", "quoted", "closed"],
      "default": "new"
    },
    "chatHistory": {
      "type": "json"
    }
  }
}
